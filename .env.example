# SIP設定（ONUのSIPアカウント情報）
SIP_DOMAIN=192.168.1.1
SIP_USER=200
SIP_AUTH_USER=0200
SIP_PASSWORD=your_sip_password

# RTP設定
# ボットが HGW と別セグメント（ルーター配下）にいる場合、SDP に載せる音声用アドレスを
# ルーターの HGW 側アドレスにし、UDP RTP_PORT〜RTP_PORT+RTP_PORT_RANGE をこのホストへ転送する。
# 同一セグメントなら空のまま
RTP_PUBLIC_ADDRESS=
RTP_PORT=4000
RTP_PORT_RANGE=20
# true にすると無音時も RTP を送り続ける（外線で音声が届かない場合の切り分け用）
RTP_DISABLE_VAD=false

# 自動ブロック設定
AUTO_BLOCK_ENABLED=true

# Webhook設定（スパム判定）
# 設定すると、着信時にGETリクエストを送信し、200番台なら非スパム、400番台ならスパムと判定
WEBHOOK_URL=
# レスポンス待ちの上限（秒）。超えると非スパム扱い
WEBHOOK_TIMEOUT_SEC=15

# MQTT設定（ログ送信）
# 設定すると、着信ログをMQTTで送信
MQTT_BROKER=
MQTT_PORT=1883
MQTT_TOPIC=
MQTT_USERNAME=
MQTT_PASSWORD=

# ログ設定
LOG_LEVEL=INFO

# 留守電設定
# VOICEMAIL_ENABLED=true にすると、正常着信もN秒無応答でボットが応答して録音する
VOICEMAIL_ENABLED=false
VOICEMAIL_ANSWER_DELAY_SEC=20
VOICEMAIL_MAX_DURATION_SEC=120
# 挨拶/拒否アナウンスのWAV(8kHz mono 16bit PCM)。未設定(空)なら同梱デフォルト
VOICEMAIL_GREETING_WAV=
REJECT_ANNOUNCE_WAV=
RECORDINGS_DIR=./recordings

# 文字起こし設定（OpenAI互換API。既定はGroq。未設定なら文字起こしをスキップ）
OPENAI_API_KEY=
# OpenAI互換のtranscriptionエンドポイント（未設定ならGroqを使用）
# 例: https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_API_URL=
TRANSCRIBE_MODEL=whisper-large-v3-turbo
