# SIP設定（ONUのSIPアカウント情報）
SIP_DOMAIN=192.168.1.1
SIP_USER=200
SIP_AUTH_USER=0200
SIP_PASSWORD=your_sip_password

# 自動ブロック設定
AUTO_BLOCK_ENABLED=true

# Webhook設定（スパム判定）
# 設定すると、着信時にGETリクエストを送信し、200番台なら非スパム、400番台ならスパムと判定
WEBHOOK_URL=

# MQTT設定（ログ送信）
# 設定すると、着信ログをMQTTで送信
MQTT_BROKER=
MQTT_PORT=1883
MQTT_TOPIC=
MQTT_USERNAME=
MQTT_PASSWORD=

# ログ設定
LOG_LEVEL=INFO
